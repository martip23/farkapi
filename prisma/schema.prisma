// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  discordId      String       @id @unique
  farkId         Int          @default(autoincrement())
  discordName    String       @unique
  nationUsername String?      @unique
  nationName     String?      @unique
  nationId       Int?         @unique
  nationVerified Boolean      @default(false)
  nationApiKey   Boolean?     @unique
  createdAt      DateTime     @default(now())
  serverData     ServerData[] @relation(name: "ServerData")
}

model ServerData {
  id         Int      @id @unique @default(autoincrement())
  discordId  String
  guildId    String
  serverName String
  username   String
  createdAt  DateTime @default(now())
  roles      String[]
  user       User     @relation(name: "ServerData", fields: [discordId], references: [discordId])
}
