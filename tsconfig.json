{
    "compilerOptions": {
        "target": "ESNext",
        "lib": [
            "esnext"
        ],
        "moduleResolution": "node",
        "esModuleInterop": true,
        "rootDir": "src",
        "outDir": "dist",
        "sourceMap": true,
        "strict": true,
    },
    "include": [
        "./src/**/*.ts"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ],
}